// polkit: let the k7bridge service account restart its own units (needed after
// an OTA binary swap) without a password. Nothing else is granted.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        subject.user == "k7bridge") {
        var unit = action.lookup("unit");
        if (unit == "k7-pi-bridge.service" || unit == "k7-pi-bridge-rollback.service") {
            var verb = action.lookup("verb");
            if (verb == "restart" || verb == "start" || verb == "stop" || verb == "try-restart") {
                return polkit.Result.YES;
            }
        }
    }
});
