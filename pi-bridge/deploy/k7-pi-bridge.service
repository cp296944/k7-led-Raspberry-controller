[Unit]
Description=K7 Pi Bridge - 24/7 K7 Pro controller
Documentation=https://github.com/cp296944/k7-led-Raspberry-controller/tree/master/pi-bridge
Wants=network-online.target
After=network-online.target
# If the process keeps failing right after an update, hand off to the rollback unit.
OnFailure=k7-pi-bridge-rollback.service
StartLimitIntervalSec=120
StartLimitBurst=4

[Service]
Type=simple
User=k7bridge
Group=k7bridge
ExecStart=/opt/k7-pi-bridge/current/k7-pi-bridge --config /opt/k7-pi-bridge/data/config.json
Restart=on-failure
RestartSec=3

# Let the non-root service bind :80 and restart itself after an OTA swap.
AmbientCapabilities=CAP_NET_BIND_SERVICE
# systemctl restart of THIS unit is allowed via the polkit rule in deploy/.

# Hardening (kept mild - it still needs outbound HTTPS + LAN + wlan0).
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/k7-pi-bridge
ProtectHome=true
PrivateTmp=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
